      "minutes": 3,
      "age": "3-6岁",
      "tag": "经典",
      "lyrics": [
        "小螺号嘀嘀嘀吹，",
        "海鸥听了展翅飞，",
        "阿爸听了笑微微，",
        "嘿咯嘿咯摇着船儿回家睡。"
      ]
    },
    {
      "id": 12,
      "title": "打电话",
      "summary": "两个小娃娃呀，正在打电话呀。",
      "minutes": 2,
      "age": "2-5岁",
      "tag": "生活",
      "lyrics": [
        "两个小娃娃呀，正在打电话呀，",
        "喂喂喂，你在哪里呀？",
        "哎哎哎，我在幼儿园。",
        "你好吗？我很好。",
        "哈哈哈……"
      ]
    },
    {
      "id": 13,
      "title": "一二三四五",
      "summary": "一二三四五，上山打老虎。",
      "minutes": 1,
      "age": "1-3岁",
      "tag": "数字",
      "lyrics": [
        "一二三四五，",
        "上山打老虎，",
        "老虎没打到，",
        "打到小松鼠。",
        "松鼠有几只，",
        "让我数一数，",
        "数来又数去，",
        "一二三四五。"
      ]
    },
    {
      "id": 14,
      "title": "泥娃娃",
      "summary": "泥娃娃，泥娃娃，一个泥娃娃。",
      "minutes": 2,
      "age": "2-5岁",
      "tag": "经典",
      "lyrics": [
        "我有一个泥娃娃，",
        "从来也不哭和闹，",
        "我做它的小妈妈，",
        "我做它的小妈妈，",
        "天天给它把歌唱。"
      ]
    },
    {
      "id": 15,
      "title": "摇啊摇",
      "summary": "摇啊摇，摇啊摇，摇到外婆桥。",
      "minutes": 2,
      "age": "1-3岁",
      "tag": "睡前",
      "lyrics": [
        "摇啊摇，摇啊摇，",
        "摇到外婆桥，",
        "外婆叫我好宝宝，",
        "糖一包，果一包，",
        "还有并蒂红樱桃。"
      ]
    },
    {
      "id": 16,
      "title": "虫儿飞",
      "summary": "黑黑的天空低垂，亮亮的繁星相随。",
      "minutes": 3,
      "age": "2-6岁",
      "tag": "睡前",
      "lyrics": [
        "黑黑的天空低垂，",
        "亮亮的繁星相随，",
        "虫儿飞，虫儿飞，",
        "你在思念谁。",
        "天上的星星笑了，",
        "地上的虫儿睡了。"
      ]
    },
    {
      "id": 17,
      "title": "划船",
      "summary": "让我们荡起双桨，小船儿推开波浪。",
      "minutes": 3,
      "age": "3-6岁",
      "tag": "经典",
      "lyrics": [
        "让我们荡起双桨，",
        "小船儿推开波浪，",
        "海面倒映着美丽的白塔，",
        "四周环绕着绿树红墙。"
      ]
    },
    {
      "id": 18,
      "title": "小鸟小鸟",
      "summary": "小鸟小鸟，轻轻地跳到窗台上。",
      "minutes": 2,
      "age": "1-4岁",
      "tag": "动物",
      "lyrics": [
        "小鸟小鸟，轻轻地跳，",
        "跳到我的窗台上，",
        "叽叽喳喳唱首歌，",
        "唱得太阳眯眯笑。"
      ]
    },
    {
      "id": 19,
      "title": "拍拍小手",
      "summary": "拍拍小手真高兴，拍拍小脚跳一跳。",
      "minutes": 1,
      "age": "1-3岁",
      "tag": "动作",
      "lyrics": [
        "拍拍小手真高兴，",
        "拍拍小脚跳一跳，",
        "转转小圈笑一笑，",
        "宝宝快乐身体好。"
      ]
    },
    {
      "id": 20,
      "title": "爸爸妈妈听我说",
      "summary": "爸爸妈妈听我说，今天我学会了一首歌。",
      "minutes": 2,
      "age": "2-5岁",
      "tag": "亲情",
      "lyrics": [
        "爸爸妈妈听我说，",
        "今天我学会了一首歌，",
        "啦啦啦，啦啦啦，",
        "唱给你们听一听，",
        "你们笑得真开心。"
      ]
    }
